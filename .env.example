# Copy to .env and fill in ONLY if you need these. Never commit the real .env file.
# The core pipeline needs none of these values.

# Optional: use a different config file than configs/config.yaml
# EWASTE_CONFIG=configs/config.yaml

# Optional: only needed if you download datasets from Roboflow with their SDK/CLI
# (the manual "Download Dataset -> YOLO" export needs no key)
# ROBOFLOW_API_KEY=your_key_here
